# GDList — 环境变量配置模板
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#   chmod 600 .env

# ── 服务 ──────────────────────────────────────────────────────────────────
PORT=3000

# 反向代理层数。用 nginx / Caddy 反代时保持 1；直接暴露 Node 时设为 0，
# 否则客户端可以伪造 X-Forwarded-For 绕过登录限流。
TRUST_PROXY=1

# 对外访问地址（可选）。填了以后分享链接固定用它，例如 https://drive.example.com
# 不填则按请求头（Host / X-Forwarded-Proto）推导。
# PUBLIC_URL=https://drive.example.com

# ── 会话与签名密钥（必填，随机 32+ 字符）────────────────────────────────
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 同时用于登录 cookie 和下载链接签名；修改后所有人需重新登录、旧链接失效。
SESSION_SECRET=change-this-to-a-random-secret

# 登录有效期（小时），默认 24
SESSION_TTL_HOURS=24

# 分享链接有效期（小时）。0 = 永不过期（默认）
SHARE_TTL_HOURS=0

# ── 管理员账号 ───────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# 密码哈希（由 install.sh 自动生成，无需手动填写）
# 生成方式：node -e "const b=require('bcryptjs');b.hash('你的密码',10).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=

# ── 数据源（多账号 / 多文件夹）───────────────────────────────────────────
# JSON 数组，每项：id（字母数字下划线短横线，≤32 位）、name、keyFile、folderId
# name 是备用名：启动时会自动替换为 Drive 中该文件夹的真实名称（读取失败才用 name）
# 注意：这里必须是一行完整 JSON，不能换行、不能加反斜杠转义。
DRIVE_SOURCES=[{"id":"work","name":"工作盘","keyFile":"/opt/gdlists/sa_1.json","folderId":"1AbcWorkFolderId"},{"id":"personal","name":"个人盘","keyFile":"/opt/gdlists/sa_2.json","folderId":"1XyzPersonalFolderId"}]

# 兼容旧单源配置：没有 DRIVE_SOURCES 时使用下面两项（作为 id=default 的源）
# GOOGLE_SERVICE_ACCOUNT_JSON=/opt/gdlists/service-account-key.json
# ROOT_FOLDER_ID=your_shared_folder_id_here

# ── 文件缓存 ─────────────────────────────────────────────────────────────
# 缓存目录固定为项目下 cache/，以下两项控制上限与保留时间
MAX_CACHE_SIZE_GB=5
CACHE_TTL_DAYS=100

# 单个文件夹最多返回多少条（防止超大目录拖垮浏览器），默认 5000
FILE_LIST_LIMIT=5000
