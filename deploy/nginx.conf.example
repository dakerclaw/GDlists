# GDlists 反向代理示例（nginx）
# 放到 /etc/nginx/sites-available/gdlists 后：
#   ln -s /etc/nginx/sites-available/gdlists /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# 证书可用 certbot 申请：
#   apt install certbot python3-certbot-nginx
#   certbot --nginx -d drive.example.com

server {
    listen 80;
    server_name drive.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name drive.example.com;

    ssl_certificate     /etc/letsencrypt/live/drive.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drive.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # 登录请求很小；如需上传功能再调大
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 文件下载/预览是流式长连接：关闭缓冲，避免 nginx 落盘与内存暴涨
        proxy_buffering off;
        proxy_request_buffering off;

        # Range 请求默认透传，无需额外配置
        proxy_connect_timeout 30s;
        proxy_send_timeout    1h;
        proxy_read_timeout    1h;
    }
}
